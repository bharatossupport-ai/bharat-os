#!/bin/sh
set -e
lb config noauto \
  --distribution trixie \
  --archive-areas "main contrib non-free non-free-firmware" \
  --architectures amd64 \
  --binary-images iso-hybrid \
  --bootappend-live "boot=live components quiet splash locales=en_IN.UTF-8 keyboard-layouts=in" \
  --iso-application "BharatOS" \
  --iso-publisher "BharatOS Project" \
  --iso-volume "BharatOS 1.0" \
  --debian-installer none \
  --memtest none \
  --apt-recommends false \
  "${@}"

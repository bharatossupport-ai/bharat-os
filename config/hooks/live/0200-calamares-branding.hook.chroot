#!/bin/sh
# Rename the installer to BharatOS
set -e
B=/etc/calamares/branding/debian/branding.desc
if [ -f "$B" ]; then
  sed -i 's/productName: .*/productName:         "BharatOS"/; s/shortProductName: .*/shortProductName:    "BharatOS"/; s/version: .*/version:             "1.0"/; s/shortVersion: .*/shortVersion:        "1.0"/; s/versionedName: .*/versionedName:       "BharatOS 1.0"/; s/shortVersionedName: .*/shortVersionedName:  "BharatOS 1.0"/; s/bootloaderEntryName: .*/bootloaderEntryName: "BharatOS"/' "$B"
fi

#!/bin/sh
set -e
# Identity
cat > /etc/os-release <<'OS'
PRETTY_NAME="BharatOS 1.0 (Ganga)"
NAME="BharatOS"
VERSION_ID="1.0"
VERSION="1.0 (Ganga)"
VERSION_CODENAME=ganga
ID=bharatos
ID_LIKE=debian
HOME_URL="https://github.com/bharatossupport-ai/bharat-os"
OS
cp /etc/os-release /usr/lib/os-release
echo "bharatos" > /etc/hostname
echo "BharatOS 1.0 \\n \\l" > /etc/issue

# Indian locales
sed -i 's/^# *\(en_IN UTF-8\)/\1/; s/^# *\(hi_IN UTF-8\)/\1/; s/^# *\(en_US.UTF-8 UTF-8\)/\1/' /etc/locale.gen
locale-gen
echo 'LANG=en_IN.UTF-8' > /etc/default/locale
ln -sf /usr/share/zoneinfo/Asia/Kolkata /etc/localtime

# Wallpaper (Himalaya photo, Unsplash licence)
mkdir -p /usr/share/wallpapers/BharatOS/contents/images
curl -fsSL -o /usr/share/wallpapers/BharatOS/contents/images/2400x1600.jpg \
  "https://images.unsplash.com/photo-1722049898631-759c07389b34?fm=jpg&q=85&w=2400&auto=format&fit=crop" || true
cat > /usr/share/wallpapers/BharatOS/metadata.json <<'MD'
{"KPlugin":{"Id":"BharatOS","Name":"BharatOS Himalaya","License":"Unsplash"}}
MD
# Make it the default Plasma wallpaper
if [ -d /usr/share/wallpapers/Next ] && [ -s /usr/share/wallpapers/BharatOS/contents/images/2400x1600.jpg ]; then
  rm -rf /usr/share/wallpapers/Next.orig; mv /usr/share/wallpapers/Next /usr/share/wallpapers/Next.orig
  ln -s BharatOS /usr/share/wallpapers/Next
fi

# Companion AI first-boot setup
systemctl enable bharatos-ai-setup.service || true

# Firewall on by default (allow KDE Connect)
ufw default deny incoming || true
ufw allow 1714:1764/tcp || true
ufw allow 1714:1764/udp || true
sed -i 's/^ENABLED=no/ENABLED=yes/' /etc/ufw/ufw.conf || true
